# --- VPS (dibaca docker-compose) ---
SHARED_SECRET=ganti-dengan-random-32-char
# htpasswd -nb admin passwordmu  → tempel hasilnya di dalam tanda kutip tunggal
BASIC_AUTH_USERS='admin:$apr1$xxxx$yyyy'
N8N_MODE=live

# --- Lokal (opsional, dibaca Nuxt saat pnpm dev) ---
# Lokal selalu mock dan tidak pernah menghubungi n8n. Tanpa .env pun jalan.
# NUXT_N8N_MODE=mock
# NUXT_DATABASE_PATH=./data/aladin.db
# NUXT_MEDIA_DIR=./data/media
# NUXT_MIGRATIONS_DIR=./server/db/migrations
#
# `pnpm preview` menjalankan build production (NODE_ENV=production), jadi server menolak
# start tanpa secret. Untuk smoke test lokal, isi (>= 32 karakter, bukan default):
# NUXT_SHARED_SECRET=ganti-dengan-random-32-char
