# --- VPS (dibaca docker-compose) ---
# Wajib diisi: docker compose menolak jalan jika SHARED_SECRET atau BASIC_AUTH_USERS kosong.
# SHARED_SECRET: random >= 32 karakter, buat di server, jangan ditampilkan atau dikirim ke chat:
#   printf 'SHARED_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# Nilainya sama dengan credential `Aladin Secret` di n8n (header X-Aladin-Secret).
SHARED_SECRET=ganti-dengan-random-32-char
# Hash BasicAuth: jalankan `openssl passwd -apr1` di server (password diketik di prompt, tidak di
# argumen), lalu tempel `admin:<hash>` di dalam tanda kutip TUNGGAL (hash berisi banyak `$`).
BASIC_AUTH_USERS='admin:$apr1$xxxx$yyyy'
# Deploy pertama memakai `mock` (tanpa n8n dan tanpa biaya API). Ganti ke `live` hanya setelah
# workflow n8n ada (change add-n8n-brand-post-workflows).
N8N_MODE=mock

# --- Lokal (opsional, dibaca Nuxt saat pnpm dev) ---
# Lokal selalu mock dan tidak pernah menghubungi n8n. Tanpa .env pun jalan.
# NUXT_N8N_MODE=mock
# NUXT_DATABASE_PATH=./data/aladin.db
# NUXT_MEDIA_DIR=./data/media
# NUXT_MIGRATIONS_DIR=./server/db/migrations
#
# `pnpm preview` menjalankan build production (NODE_ENV=production), jadi server menolak
# start tanpa secret. Untuk smoke test lokal, isi (>= 32 karakter, bukan default):
# NUXT_SHARED_SECRET=ganti-dengan-random-32-char
